@using PTO_web_application.Models.ViewModels.Auth
@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_ApplyLayout"; // Assuming you have a clean layout for auth pages
}

<div class="pto-auth-page">
    <a href="/Auth/Login" class="pto-back-link">
        <i class="bi bi-arrow-left"></i> Back
    </a>

    <div class="pto-auth-card">
        <div class="pto-auth-logo">
            <img src="~/images/logo.png" alt="PTO" onerror="this.style.display='none'" />
        </div>

        <h2 class="pto-auth-title">Forgot Password</h2>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="pto-auth-error">
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <p style="font-size: 14px; color: #666; margin-bottom: 25px; text-align: left;">
            Enter your ID Number. We will send a password reset link to the email address you used during your application.
        </p>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="pto-auth-form">
            @Html.AntiForgeryToken()

            <div class="pto-form-group">
                <label asp-for="IdNumber" class="pto-form-label">ID Number</label>
                <input asp-for="IdNumber" class="pto-form-input" placeholder="Enter your 13-digit ID" maxlength="13" />
                <span asp-validation-for="IdNumber" class="pto-form-error"></span>
            </div>

            <button type="submit" class="pto-btn-login-submit" style="margin-top: 20px;">
                Send Reset Link
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}