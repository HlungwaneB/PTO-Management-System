@model PTO_web_application.Models.ViewModels.ApplyContactViewModel

@{
    ViewData["Title"] = "Apply - Contact Information";
    Layout = "_ApplyLayout";
}

<header class="pto-apply-header">
    <div class="pto-apply-brand">
        <span class="pto-brand-my">my</span>
        <span class="pto-brand-pto">PTO</span>
        <span class="pto-brand-partner">
            <img src="~/images/logo.png" alt="Mangaung" />
            <span class="pto-brand-text">MANGAUNG</span>
        </span>
    </div>
</header>

<nav class="pto-apply-subnav">
    <a href="#about" class="pto-subnav-link">About us</a>
    <a href="/Apply" class="pto-subnav-link pto-subnav-active">Apply</a>
   
    <a href="#contact" class="pto-subnav-link">Contact us</a>
</nav>

<main class="pto-apply-main">
    <div class="pto-apply-card">
        <div class="pto-apply-card-title">
            PTO Application
        </div>

        <form asp-controller="Apply" asp-action="Contact" method="post" class="pto-apply-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!--  SITE SELECTION DROPDOWN -->
            <div class="pto-apply-row">
                <label asp-for="SelectedSiteId" class="pto-apply-label">Select Site *</label>
                <div class="pto-apply-field">
                    <select asp-for="SelectedSiteId" asp-items="Model.AvailableSites" class="pto-apply-input" style="background: #d9d9d9; border: 1px solid #c0c0c0; border-radius: 20px; padding: 10px 20px; width: 100%; max-width: 380px; font-size: 16px; color: #1A1A1A; outline: none;">
                        <option value="">-- Choose a site --</option>
                    </select>
                    <span asp-validation-for="SelectedSiteId" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Cellphone -->
            <div class="pto-apply-row">
                <label asp-for="Cellphone" class="pto-apply-label">Cellphone</label>
                <div class="pto-apply-field">
                    <input asp-for="Cellphone" class="pto-apply-input" maxlength="10" />
                    <span asp-validation-for="Cellphone" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Confirm cellphone -->
            <div class="pto-apply-row">
                <label asp-for="ConfirmCellphone" class="pto-apply-label">Confirm cellphone</label>
                <div class="pto-apply-field">
                    <input asp-for="ConfirmCellphone" class="pto-apply-input" maxlength="10" />
                    <span asp-validation-for="ConfirmCellphone" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- E-mail address -->
            <div class="pto-apply-row">
                <label asp-for="EmailAddress" class="pto-apply-label">E-mail address</label>
                <div class="pto-apply-field">
                    <input asp-for="EmailAddress" type="email" class="pto-apply-input" />
                    <span asp-validation-for="EmailAddress" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Confirm e-mail address -->
            <div class="pto-apply-row">
                <label asp-for="ConfirmEmailAddress" class="pto-apply-label">Confirm e-mail address</label>
                <div class="pto-apply-field">
                    <input asp-for="ConfirmEmailAddress" type="email" class="pto-apply-input" />
                    <span asp-validation-for="ConfirmEmailAddress" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Home cellphone -->
            <div class="pto-apply-row">
                <label asp-for="HomeCellphone" class="pto-apply-label">Home cellphone</label>
                <div class="pto-apply-field">
                    <input asp-for="HomeCellphone" class="pto-apply-input" />
                </div>
            </div>

            <!-- Are you dependant -->
            <div class="pto-apply-row">
                <label class="pto-apply-label">Have a dependant</label>
                <div class="pto-apply-field pto-gender-field">
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="IsDependant" value="Yes" />
                        <span>YES</span>
                    </label>
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="IsDependant" value="No" />
                        <span>NO</span>
                    </label>
                </div>
            </div>

            <!-- Footer -->
            <div class="pto-apply-footer">
                <button type="submit" class="pto-btn-save">Save and Continue</button>
                <a href="/Apply/Personal" class="pto-btn-back">Back</a>
                <a href="/" class="pto-btn-cancel">Cancel</a>
            </div>

        </form>
    </div>
</main>
