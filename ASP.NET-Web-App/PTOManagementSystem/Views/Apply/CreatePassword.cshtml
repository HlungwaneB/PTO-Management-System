@model PTO_web_application.Models.ViewModels.ApplyCreatePasswordViewModel

@{
    ViewData["Title"] = "Apply - Create Password";
    Layout = "_ApplyLayout";
}

<!-- HEADER  -->
<header class="pto-apply-header">
    <div class="pto-apply-brand">
        <span class="pto-brand-my">my</span>
        <span class="pto-brand-pto">PTO</span>
        <span class="pto-brand-partner">
            <img src="~/images/logo.png" alt="Mangaung" />
            <span class="pto-brand-text">MANGAUNG</span>
        </span>
    </div>
</header>

<!--  ORANGE SUB-NAV  -->
<nav class="pto-apply-subnav">
    <a href="/Home/Index" class="pto-subnav-link">About us</a>
    <a href="/Apply" class="pto-subnav-link pto-subnav-active">Apply</a>
  
    <a href="#contact" class="pto-subnav-link">Contact us</a>
</nav>

<!--  MAIN  -->
<main class="pto-apply-main">
    <div class="pto-apply-card">

        <!-- Card title -->
        <div class="pto-apply-card-title">
            PTO Application
        </div>

        <form asp-controller="Apply" asp-action="CreatePassword" method="post" class="pto-apply-form">
            @Html.AntiForgeryToken()

            <!-- General errors -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Password -->
            <div class="pto-apply-row">
                <label asp-for="Password" class="pto-apply-label">Password</label>
                <div class="pto-apply-field">
                    <input asp-for="Password" type="password" class="pto-apply-input" />
                    <!--  Show error here -->
                    <span asp-validation-for="Password" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="pto-apply-row">
                <label asp-for="ConfirmPassword" class="pto-apply-label">Confirm Password</label>
                <div class="pto-apply-field">
                    <input asp-for="ConfirmPassword" type="password" class="pto-apply-input" />
                    <!--  Show error here -->
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Footer -->
            <div class="pto-apply-footer">
                <button type="submit" class="pto-btn-save">Save and Continue</button>
                <a href="/Apply/Documents" class="pto-btn-back">Back</a>
                <a href="/" class="pto-btn-cancel">Cancel</a>
            </div>

        </form>
    </div>
</main>
