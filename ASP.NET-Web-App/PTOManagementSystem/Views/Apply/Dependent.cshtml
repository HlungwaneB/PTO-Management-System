@model PTO_web_application.Models.ViewModels.ApplyDependentViewModel

@{
    ViewData["Title"] = "Apply - Dependent Information";
    Layout = "_ApplyLayout";
}

<!--  HEADER  -->
<header class="pto-apply-header">
    <div class="pto-apply-brand">
        <span class="pto-brand-my">my</span>
        <span class="pto-brand-pto">PTO</span>
        <span class="pto-brand-partner">
            <img src="~/images/logo.png" alt="Mangaung" />
            <span class="pto-brand-text">MANGAUNG</span>
        </span>
    </div>
</header>

<!--  ORANGE SUB-NAV  -->
<nav class="pto-apply-subnav">
    <a href="/Home/Index" class="pto-subnav-link">About us</a>
    <a href="/Apply" class="pto-subnav-link pto-subnav-active">Apply</a>
    <a href="#" class="pto-subnav-link">Track Application</a>
    <a href="#contact" class="pto-subnav-link">Contact us</a>
</nav>

<!--  MAIN  -->
<main class="pto-apply-main">
    <div class="pto-apply-card">

        <div class="pto-apply-card-title">
            PTO Application
        </div>

        <form asp-controller="Apply" asp-action="Dependent" method="post" class="pto-apply-form">
            @Html.AntiForgeryToken()

            <!-- Section subtitle -->
            <h2 class="pto-subsection-title">Dependent Information</h2>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!--  Relationship Dropdown -->
            <div class="pto-apply-row">
                <label asp-for="Relationship" class="pto-apply-label">Relationship</label>
                <div class="pto-apply-field">
                    <select asp-for="Relationship" class="pto-apply-input" style="background: #d9d9d9; border: 1px solid #c0c0c0; border-radius: 20px; padding: 10px 20px;">
                        <option value="">Select Relationship...</option>
                        <option value="Spouse">Spouse</option>
                        <option value="Child">Child</option>
                        <option value="Parent">Parent</option>
                        <option value="Sibling">Sibling</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Relationship" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Surname -->
            <div class="pto-apply-row">
                <label asp-for="Surname" class="pto-apply-label">Surname</label>
                <div class="pto-apply-field">
                    <input asp-for="Surname" class="pto-apply-input" />
                    <span asp-validation-for="Surname" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Initials -->
            <div class="pto-apply-row">
                <label asp-for="Initials" class="pto-apply-label">Initials</label>
                <div class="pto-apply-field">
                    <input asp-for="Initials" class="pto-apply-input" maxlength="10" />
                    <span asp-validation-for="Initials" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- First name(s) -->
            <div class="pto-apply-row">
                <label asp-for="FirstNames" class="pto-apply-label">First name(s)</label>
                <div class="pto-apply-field">
                    <input asp-for="FirstNames" class="pto-apply-input" />
                    <span asp-validation-for="FirstNames" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- ID Number -->
            <div class="pto-apply-row">
                <label asp-for="IdNumber" class="pto-apply-label">ID Number ⁄ Permanent ID NO</label>
                <div class="pto-apply-field">
                    <input asp-for="IdNumber" class="pto-apply-input" maxlength="13" />
                    <span asp-validation-for="IdNumber" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Cellphone -->
            <div class="pto-apply-row">
                <label asp-for="Cellphone" class="pto-apply-label">Cellphone</label>
                <div class="pto-apply-field">
                    <input asp-for="Cellphone" class="pto-apply-input" maxlength="10" />
                    <span asp-validation-for="Cellphone" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="pto-apply-row">
                <label asp-for="EmailAddress" class="pto-apply-label">E-mail address</label>
                <div class="pto-apply-field">
                    <input asp-for="EmailAddress" type="email" class="pto-apply-input" />
                    <span asp-validation-for="EmailAddress" class="text-danger" style="font-size: 13px;"></span>
                </div>
            </div>

            <!-- Footer -->
            <div class="pto-apply-footer">
                <button type="submit" class="pto-btn-save">Save and Continue</button>
                <a href="/Apply/Contact" class="pto-btn-back">Back</a>
                <a href="/" class="pto-btn-cancel">Cancel</a>
            </div>

        </form>
    </div>
</main>
