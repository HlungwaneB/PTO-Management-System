@using PTO_web_application.Models.ViewModels.Dashboard
@model RenewPtoViewModel

@{
    ViewData["Title"] = "Renew PTO";
    Layout = "_DashboardLayout";
}

<main style="padding: 60px 80px; background: #f8f9fa; min-height: 75vh;">


    <!-- 🟢 ERROR DISPLAY -->
    @if (ViewData["ErrorMessage"] != null)
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb; max-width: 1200px; margin-left: auto; margin-right: auto;">
            <strong>Error:</strong> @ViewData["ErrorMessage"]
        </div>
    }

    <div style="background: #ffffff; border: 1px solid #c0c0c0; border-radius: 8px; max-width: 1200px; margin: 0 auto; overflow: hidden;">
    <div style="background: #ffffff; border: 1px solid #c0c0c0; border-radius: 8px; max-width: 1200px; margin: 0 auto; overflow: hidden;">

     
        <div style="background: #e0e0e0; padding: 12px; text-align: center; font-size: 16px; font-weight: 600; color: #333; border-bottom: 1px solid #c0c0c0;">
            Renew PTO
        </div>

       
        <form asp-controller="Renew" asp-action="Index" method="post" style="padding: 30px 40px;">
            @Html.AntiForgeryToken()

            <!-- Expiry Date -->
            <div style="display: flex; margin-bottom: 20px;">
                <div style="width: 250px; font-size: 14px; color: #555;">Expiry date checked</div>
                <div style="font-size: 14px; font-weight: 500; color: #1A1A1A;">@Model.ExpiryText</div>
            </div>

            <!-- Still living at the site -->
            <div style="display: flex; margin-bottom: 20px; align-items: center;">
                <div style="width: 250px; font-size: 14px; color: #555;">Still living at the site</div>
                <div style="display: flex; gap: 30px;">
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="StillLivingAtSite" value="Yes" />
                        <span>YES</span>
                    </label>
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="StillLivingAtSite" value="No" />
                        <span>NO</span>
                    </label>
                </div>
            </div>

            <!-- Change in income -->
            <div style="display: flex; margin-bottom: 20px; align-items: center;">
                <div style="width: 250px; font-size: 14px; color: #555;">Change in income or household</div>
                <div style="display: flex; gap: 30px;">
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="ChangeInIncome" value="Yes" id="incomeYes" />
                        <span>YES</span>
                    </label>
                    <label class="pto-radio-label">
                        <input type="radio" asp-for="ChangeInIncome" value="No" id="incomeNo" />
                        <span>NO</span>
                    </label>
                </div>
            </div>

            <!--NEW INCOME FIELD-->
            <div id="newIncomeDiv" style="display: none; margin-bottom: 20px; align-items: center;">
                <div style="width: 250px; font-size: 14px; color: #555;">New Monthly Income (R)</div>
                <input asp-for="NewMonthlyIncome" style="width: 300px; padding: 10px 12px; border: 1px solid #c0c0c0; border-radius: 4px; background: #f0f0f0; font-size: 14px; outline: none;" placeholder="e.g. 2500" />
            </div>

            <!-- Notes -->
            <div style="display: flex; margin-bottom: 20px; align-items: center;">
                <div style="width: 250px; font-size: 14px; color: #555;">Notes (optional)</div>
                <input asp-for="Notes" style="width: 300px; padding: 8px 12px; border: 1px solid #c0c0c0; border-radius: 4px; background: #f0f0f0; font-size: 14px; outline: none;" />
            </div>

            <!-- Footer Buttons -->
            <div style="background: #e0e0e0; margin: 40px -40px -30px -40px; padding: 16px 40px; border-top: 1px solid #c0c0c0; display: flex; gap: 12px;">
                <button type="submit" style="background: #a8a8a8; color: white; border: none; padding: 10px 20px; border-radius: 4px; font-size: 14px; cursor: pointer;">
                    Submit renewal request
                </button>
                <a href="/Dashboard" style="background: #c0c0c0; color: #333; text-decoration: none; padding: 10px 20px; border-radius: 4px; font-size: 14px;">
                    Cancel
                </a>
            </div>

        </form>
    </div>

</main>

@section Scripts {
    <script>
        // Logic
        document.addEventListener('DOMContentLoaded', function() {
            const yesRadio = document.getElementById('incomeYes');
            const noRadio = document.getElementById('incomeNo');
            const incomeDiv = document.getElementById('newIncomeDiv');

            function toggleIncomeField() {
                if (yesRadio.checked) {
                    incomeDiv.style.display = 'flex';
                } else {
                    incomeDiv.style.display = 'none';
                }
            }

            yesRadio.addEventListener('change', toggleIncomeField);
            noRadio.addEventListener('change', toggleIncomeField);

            // Initial check on page load
            toggleIncomeField();
        });
    </script>
}